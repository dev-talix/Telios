{
  "name": "@telos-ai/telos",
  "version": "0.1.0",
  "exports": "./server/main.ts",
  "tasks": {
    "start": "deno run -A server/main.ts",
    "dev": "deno run -A --watch server/main.ts",
    "ui:build": "cd ui && pnpm build",
    "ui:dev": "cd ui && pnpm dev",
    "build": "deno task ui:build",
    "compile": "deno compile -A --output telos server/main.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.7.0",
    "hono/cors": "npm:hono@^4.7.0/cors",
    "hono/logger": "npm:hono@^4.7.0/logger",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "croner": "npm:croner@^9.0.0"
  }
}
